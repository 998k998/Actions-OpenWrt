# ===================================================================
# OpenWrt 25.12 稳定版 Target 配置
# ===================================================================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_jdcloud_re-cs-03=y
CONFIG_TARGET_BOARD="qualcommax"
CONFIG_TARGET_SUBTARGET="ipq50xx"
CONFIG_TARGET_PROFILE="DEVICE_jdcloud_re-cs-03"

# Kernel 优化
CONFIG_KERNEL_SKB_RECYCLER=y
CONFIG_KERNEL_SKB_RECYCLER_MULTI_CPU=y

# ===================================================================
# NSS 硬件加速驱动 (25.12 稳定版架构)
# ===================================================================
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-edma=y
CONFIG_PACKAGE_qca-nss-fw-ipq5018=y

# ECM 硬件加速连接管理
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_qca-nss-ecm-auto=y
CONFIG_PACKAGE_qca-nss-ecm-pppoe_plugin=y
CONFIG_PACKAGE_qca-nss-ecm-ipv6_plugin=y

# 用户态 NSS 控制工具
CONFIG_PACKAGE_qca-nss-cli=y

# ===================================================================
# Web UI 与基础组件
# ===================================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-app-nss-info=y

# 常用工具
CONFIG_PACKAGE_autocore-arm=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ethtool=y
