# ===================================================================
# 目标平台与设备配置 (Qualcomm IPQ5018 / RE-CS-03)
# ===================================================================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_jdcloud_re-cs-03=y
CONFIG_TARGET_BOARD="qualcommax"
CONFIG_TARGET_SUBTARGET="ipq50xx"
CONFIG_TARGET_PROFILE="DEVICE_jdcloud_re-cs-03"

# ===================================================================
# Core Kernel & System Configuration
# ===================================================================
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y
CONFIG_KERNEL_SKB_RECYCLER=y
CONFIG_KERNEL_SKB_RECYCLER_MULTI_CPU=y

# ===================================================================
# Qualcomm NSS 核心驱动与硬件加速模块 (NSS Core & Driver)
# ===================================================================
CONFIG_PACKAGE_kmod-qca-nss-drv=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-lag-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-crypto=y
CONFIG_PACKAGE_kmod-qca-nss-cfi=y

# 固件支持与网络驱动 (EDMA & Firmware)
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-edma=y
CONFIG_PACKAGE_qca-nss-fw-ipq5018=y

# ===================================================================
# ECM (Enhanced Connectivity Manager - 硬件加速连接管理)
# ===================================================================
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_qca-nss-ecm-auto=y
CONFIG_PACKAGE_kmod-qca-nss-ecm-standard=y

# ECM 协议特性支持
CONFIG_PACKAGE_kmod-qca-nss-macsec=y
CONFIG_PACKAGE_qca-nss-ecm-pppoe_plugin=y
CONFIG_PACKAGE_qca-nss-ecm-ipv6_plugin=y

# ===================================================================
# 网络工具与 NSS 管理用户态组件 (NSS Userspace Tools)
# ===================================================================
CONFIG_PACKAGE_qca-nss-cli=y
CONFIG_PACKAGE_qca-nss-gmac=y

# ===================================================================
# 基础 LuCI 界面与主题插件
# ===================================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# NSS 硬件加速监控界面
CONFIG_PACKAGE_luci-app-nss-info=y

# ===================================================================
# 常用基础网络工具包
# ===================================================================
CONFIG_PACKAGE_autocore-arm=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
